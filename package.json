{
  "name": "combat-clean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/lfs-setup.mjs",
    "dev": "vite --open",
    "build": "tsc && vite build",
    "build:cap": "tsc && vite build --mode capacitor",
    "preview": "vite preview",
    "scaffold": "node config/scaffold.mjs",
    "sync-art": "node tools/char-art-pipeline/export-to-game.mjs --no-build && node tools/merge-icon-pipeline/export-to-game.mjs && npm run game-config:validate && npm run assets:validate && npm run build",
    "game-config:validate": "node config/scaffold.mjs config validate",
    "game-config:lint": "node config/scaffold.mjs config lint",
    "visual-config:validate": "node config/scaffold.mjs visual validate",
    "assets:validate": "node config/scaffold.mjs assets validate",
    "cap:sync": "npm run build:cap && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android:debug": "npm run cap:sync && cd android && .\\gradlew.bat assembleDebug",
    "cap:android:studio": "npm run cap:sync && npx cap open android",
    "adb:install": "adb install -r android\\app\\build\\outputs\\apk\\debug\\app-debug.apk",
    "adb:run": "npm run adb:install && adb shell am start -n com.simonhill.combatclean/com.simonhill.combatclean.MainActivity",
    "cap:android:deploy": "npm run cap:android:debug && npm run adb:run"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@fortis/bishop-asset-processors": "^1.0.0",
    "@fortis/bishop-asset-registry": "^1.1.0",
    "@fortis/bishop-asset-types-2d": "^1.0.0",
    "@fortis/bishop-config-registry": "^1.0.0",
    "@fortis/bishop-meta-client": "^1.0.0",
    "@fortis/bishop-meta-contract": "^1.0.0",
    "@fortis/bishop-render-contract": "^1.0.0",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@fortis/bishop-device-preview": "^1.0.0",
    "@fortis/bishop-marksman": "^1.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  },
  "overrides": {
    "@fortis/bishop-asset-registry": "$@fortis/bishop-asset-registry"
  }
}
